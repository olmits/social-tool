{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-file.sh\"",
            "statusMessage": "Running biome check",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-all.sh\"",
            "statusMessage": "Biome check (apps/admin)",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
