# Copy to .env.local and fill in. All values are SERVER-ONLY — the admin panel is a
# BFF: the browser talks only to Next's own origin, and Next attaches the API key
# when it calls the Java core API. Do NOT prefix these with NEXT_PUBLIC_.

# Base URL of the Java core API (services/api).
API_BASE_URL=http://localhost:8080

# Shared secret sent as the `X-API-Key` header on every API call. Local dev value
# is `local-dev-api-key`; use a real secret in any shared environment.
API_KEY=replace-me
